# Keeps `secretlint "**/*"` from walking directories it would only discard later.
# .secretlintrc.json's lint.ignores filters findings *after* the glob has already
# traversed every file, so node_modules alone (>1GB) made the pre-push hook hang.
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.wrangler/
**/.wrangler/
.next/
**/.next/
coverage/
**/coverage/
.worktrees/
.git/
package-lock.json
**/*.sqlite
.data/
**/.data/
**/drizzle/meta/
**/tsconfig.tsbuildinfo
linebot-lecture-src/
lean/.lake/
**/lake-packages/

# Local-only credentials, gitignored and never committed. Scanning them only
# produces findings for files that cannot reach the remote. Committed samples
# (.env.example, .env.*.example) are still scanned.
.env
.env.local
**/.dev.vars
