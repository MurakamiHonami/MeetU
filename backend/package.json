{
  "name": "meetu-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run --project integration --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:staging": "vitest run --project staging",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:d1-local": "wrangler d1 migrations apply meetu-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply meetu-db-staging --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply meetu-db --remote --env production",
    "db:verify": "drizzle-kit check",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:staging": "tsx scripts/seed.ts --staging"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "ngeohash": "^0.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/ngeohash": "^0.6.8",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.4",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  }
}
