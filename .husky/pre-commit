#!/usr/bin/env sh
set -e

# .env / .dev.vars の誤コミットをブロック（*.example は許可）
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
BLOCKED=$(echo "$STAGED" | grep -E '(^|/)\.env(\.|$)|(^|/)\.dev\.vars$' | grep -v '\.example$' || true)
if [ -n "$BLOCKED" ]; then
  echo "❌ シークレットファイルをコミットしようとしています:"
  echo "$BLOCKED"
  echo "→ .env.example / .dev.vars.example のみコミット可能です"
  exit 1
fi

# ステージ済みファイルのシークレットスキャン + lint/format
npx lint-staged

# TS ファイルの変更があるときだけ型チェック（lint は構文レベルなので型崩れは検出できない）
if echo "$STAGED" | grep -qE '\.(ts|tsx)$'; then
  echo "Running typecheck (just typecheck)..."
  just typecheck
fi
