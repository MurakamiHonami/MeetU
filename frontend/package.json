{
  "name": "meetu-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "build:staging": "APP_ENV=staging next build",
    "build:production": "APP_ENV=production next build",
    "typecheck": "rm -f tsconfig.tsbuildinfo && tsc --noEmit",
    "deploy:staging": "npm run build:staging && npx --prefix ../backend wrangler deploy --config wrangler.staging.json",
    "deploy:production": "npm run build:production && npx --prefix ../backend wrangler deploy --config wrangler.production.json",
    "preview": "next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@types/leaflet": "^1.9.22",
    "hono": "^4.13.5",
    "leaflet": "^1.9.4",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
